        "type": "string"
      },
      "page": {
        "minLength": 1,
        "pattern": "^\\S(?:.*\\S)?$",
        "type": "string"
      },
      "tool": {
        "default": "annotation",
        "enum": [
          "annotation",
          "lasso",
          "proximity",
          "knn"
        ]
      }
    },
    "required": [
      "cells"
    ],
    "type": "object"
  },
  "type": "highlight.cells",
  "version": 1
