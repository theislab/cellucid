{
  "name": "cellucid-web",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node scripts/run-web-tests.mjs",
    "test:browser": "playwright test",
    "test:browser:bounded": "node scripts/run-browser-shard-bounded.mjs",
    "test:browser:repeat": "node scripts/run-browser-specs-repeat.mjs",
    "test:live-agents": "CELLUCID_LIVE_AGENTS=1 playwright test tests/browser/live-agents --project=chromium --workers=1",
    "test:worker-bundle": "npx --yes wrangler@4.115.0 deploy --dry-run --config wrangler.community-annotations.jsonc",
    "test:relay-bundle": "npx --yes wrangler@4.115.0 deploy --dry-run --config wrangler.relay.jsonc",
    "bench:analysis": "node scripts/benchmark-analysis.mjs",
    "bench:anndata": "node scripts/benchmark-anndata.mjs",
    "bench:hdf5": "node scripts/benchmark-hdf5-reader.mjs",
    "bench:formats": "node scripts/benchmark-formats.mjs",
    "stress:history": "node scripts/history-stress.mjs"
  },
  "engines": {
    "node": ">=22.15"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "esbuild": "0.28.2",
    "h5wasm": "0.10.3"
  }
}
