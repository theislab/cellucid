# Developer secrets for Cellucid's live agent tests (the chat bar with real providers).
# Copy this file to `.env` in this folder and fill in what you have. `.env` is ignored by git,
# never served by the test server (scripts/serve-browser-tests.mjs) and never part of the site.
# Use keys with a spending limit; they are read only by local test scripts, never by the page code.

# OpenAI API key (platform.openai.com › API keys), for the ChatGPT provider of the chat bar.
OPENAI_API_KEY=

# Anthropic API key (console.anthropic.com › API keys), for the Claude provider of the chat bar.
ANTHROPIC_API_KEY=
