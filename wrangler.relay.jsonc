{
  "name": "cellucid-relay",
  "main": "relay/worker.js",
  "compatibility_date": "2026-07-25",
  "compatibility_flags": ["enable_request_signal"],
  "workers_dev": false,
  "routes": [{ "pattern": "mcp.cellucid.com", "custom_domain": true }],
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      { "name": "PAIRING", "class_name": "RelayPairing" },
      { "name": "APPROVAL", "class_name": "RelayApproval" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RelayPairing", "RelayApproval"] }
  ]
}
